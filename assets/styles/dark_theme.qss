/* ЛитейныйЦех PRO: единая контрастная тёмная тема.
   Светлые фоны текстовых полей и всплывающих окон недопустимы. */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background-color: #151C26; color: #E8EEF6;
}
QWidget { color: #E8EEF6; font-family: "Segoe UI", Arial, sans-serif; font-size: 13px; }
QLabel { color: #E8EEF6; background-color: transparent; }
QLabel[secondary="true"] { color: #B8C5D4; }
QGroupBox {
    color: #E8EEF6; background: #202A38;
    border: 1px solid #45566B; border-radius: 7px;
    margin-top: 19px; padding-top: 14px; font-weight: bold;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
    left: 12px; padding: 0 6px; color: #E8A66F; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit,
QPlainTextEdit, QTextBrowser, QDateEdit, QTimeEdit {
    background-color: #111A25; color: #E8EEF6;
    border: 1px solid #45566B; border-radius: 5px;
    padding: 6px 9px; selection-background-color: #375D77;
    selection-color: #FFFFFF;
}
QTextEdit, QPlainTextEdit, QTextBrowser { padding: 9px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QTextBrowser:focus {
    border: 2px solid #E8A66F;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled,
QDoubleSpinBox:disabled { background: #263242; color: #94A5B7; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView, QCompleter QAbstractItemView {
    background-color: #111A25; color: #E8EEF6;
    border: 1px solid #45566B; alternate-background-color: #202A38;
    selection-background-color: #375D77; selection-color: #FFFFFF;
}
QTableWidget, QTableView, QListWidget, QListView, QTreeView {
    background-color: #111A25; alternate-background-color: #202A38;
    color: #E8EEF6; border: 1px solid #45566B;
    gridline-color: #344255; selection-background-color: #375D77;
    selection-color: #FFFFFF; outline: 0;
}
QTableWidget::item, QTableView::item { padding: 4px 7px; }
QTableWidget::item:selected, QTableView::item:selected,
QListView::item:selected, QTreeView::item:selected {
    background-color: #375D77; color: #FFFFFF;
}
QHeaderView, QTableCornerButton::section { background: #202A38; }
QHeaderView::section {
    background-color: #293649; color: #E8EEF6;
    border: 1px solid #45566B; padding: 7px; font-weight: bold;
}
QPushButton, QDialogButtonBox QPushButton {
    background-color: #344255; color: #E8EEF6;
    border: 1px solid #52667D; border-radius: 5px;
    padding: 8px 14px; min-height: 22px; font-weight: 600;
}
QPushButton:hover { background-color: #41546B; border-color: #E8A66F; }
QPushButton:pressed { background-color: #293649; }
QPushButton:checked { background: #3C5668; border-color: #E8A66F; }
QPushButton:disabled { background: #283343; color: #8494A7; border-color: #39485B; }
QCheckBox, QRadioButton { background: transparent; color: #E8EEF6; spacing: 8px; }
QMenu { background-color: #202A38; color: #E8EEF6; border: 1px solid #45566B; }
QMenu::item:selected { background: #375D77; color: #FFFFFF; }
QToolTip { background: #273548; color: #E8EEF6; border: 1px solid #45566B; padding: 6px; }
QTabWidget::pane { border: 1px solid #45566B; background: #151C26; }
QTabBar::tab { background: #202A38; color: #B8C5D4;
    border: 1px solid #45566B; padding: 9px 16px; }
QTabBar::tab:selected { background: #34495E; color: #E8EEF6; }
QScrollArea, QScrollArea QWidget#qt_scrollarea_viewport {
    background-color: #151C26; border: none;
}
QScrollBar:vertical { background: #151C26; width: 13px; margin: 0; }
QScrollBar:horizontal { background: #151C26; height: 13px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #52657A; border-radius: 5px; min-height: 28px; min-width: 28px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #71879E;
}
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; }
QSplitter::handle { background: #45566B; }
QStatusBar { background: #202A38; color: #B8C5D4; border-top: 1px solid #45566B; }
